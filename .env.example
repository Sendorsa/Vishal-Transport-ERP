# Supabase — copy this file to .env.local (git-ignored) and fill in the values from
# Supabase dashboard → Project Settings → API Keys / Data API. Placeholders only; never commit real values.

# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_…). Safe in the browser: Row Level Security decides what it can read.
# Never put the secret key (sb_secret_…) or the legacy service_role key here — the app refuses it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_…) — SERVER-ONLY. Never prefix it with NEXT_PUBLIC_ and never import it in browser code.
# Nothing reads it yet; leave it empty until a server-side feature needs it.
SUPABASE_SECRET_KEY=

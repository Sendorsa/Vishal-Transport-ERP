# Supabase — copy this file to .env.local (git-ignored) and fill in the values from
# Supabase dashboard → Project Settings → API Keys / Data API. Placeholders only; never commit real values.

# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_…). Safe in the browser: Row Level Security decides what it can read.
# Never put the secret key (sb_secret_…) or the legacy service_role key here — the app refuses it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_…) — SERVER-ONLY. Never prefix it with NEXT_PUBLIC_ and never import it in browser code.
# Nothing reads it yet; leave it empty until a server-side feature needs it.
SUPABASE_SECRET_KEY=

# Shared database (business data in Supabase; docs/SUPABASE_SHARED_DATA_MIGRATION_PLAN.md).
# "local" (default) = each browser's own storage; "supabase" = every approved user shares one database.
# Switch to "supabase" only after the go-live steps in SUPABASE_SETUP.md §8.
NEXT_PUBLIC_DATA_BACKEND=local

# Postgres connection for the Next.js server — SERVER-ONLY, never NEXT_PUBLIC_. The Supavisor pooler in transaction mode
# (port 6543) as the erp_server login (migration 20261103000100), e.g.
#   postgresql://erp_server.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# erp_server holds no privileges of its own: each request switches to the signed-in user (RLS applies).
# Production only in Vercel's Production environment — never in Preview / Development.
SUPABASE_DB_URL=
